# Backend Environment Variables - SQLite Configuration

# Database Configuration - SQLite (no PostgreSQL needed)
DATABASE_URL=sqlite+aiosqlite:///./dashboard.db

# Application Environment
ENVIRONMENT=development
DEBUG=true

# CORS Configuration (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Query Configuration
QUERY_TIMEOUT=30
MAX_QUERY_RESULTS=10000

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=300

# Security
SECRET_KEY=your-secret-key-change-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO
