# ══════════════════════════════════════════════════════════════
# Application Configuration
# ══════════════════════════════════════════════════════════════

# Environment: local, development, production
ENVIRONMENT=local
DASHBOARD_CONFIG_DIR=../frontend/src/config/dashboards
# Debug mode (set to false in production)
DEBUG=true

# ══════════════════════════════════════════════════════════════
# Database Configuration
# ══════════════════════════════════════════════════════════════

# SQLite (local/dev)
DATABASE_URL=sqlite+aiosqlite:///./dashboard.db

# PostgreSQL (production - example)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dashboard_db

# Azure SQL (production - example)
# DATABASE_URL=mssql+pyodbc://username:password@server.database.windows.net/dbname?driver=ODBC+Driver+18+for+SQL+Server

# ══════════════════════════════════════════════════════════════
# Azure OpenAI Configuration
# ══════════════════════════════════════════════════════════════

# IMPORTANT: Get these values from Azure Portal → Your OpenAI Resource → Keys and Endpoint

# Your Azure OpenAI Service endpoint
# Format: https://YOUR-RESOURCE-NAME.openai.azure.com/
# Use the OPENAI endpoint, not the services.ai.azure.com one
AZURE_OPENAI_ENDPOINT=https://<>.azure.com/

# Keep your deployment
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Use a VALID API version
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# API Key (LOCAL/DEV ONLY - leave empty for Managed Identity in production)
# Get from: Azure Portal → Keys and Endpoint → Key 1
AZURE_OPENAI_API_KEY=<>


# AI Response Settings
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.1

# ══════════════════════════════════════════════════════════════
# CORS Configuration
# ══════════════════════════════════════════════════════════════

# Allowed frontend origins (comma-separated, no spaces)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ══════════════════════════════════════════════════════════════
# Query Configuration
# ══════════════════════════════════════════════════════════════

QUERY_TIMEOUT=30
MAX_QUERY_RESULTS=10000

# ══════════════════════════════════════════════════════════════
# Cache Configuration
# ══════════════════════════════════════════════════════════════

CACHE_ENABLED=true
CACHE_TTL=300
REDIS_URL=redis://localhost:6379

# ══════════════════════════════════════════════════════════════
# Security
# ══════════════════════════════════════════════════════════════

# CHANGE THIS IN PRODUCTION - use a strong random string
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ══════════════════════════════════════════════════════════════
# Local Development Quick Start
# ══════════════════════════════════════════════════════════════
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Get your Azure OpenAI credentials:
#    - Go to Azure Portal
#    - Navigate to your OpenAI resource
#    - Click "Keys and Endpoint"
#    - Copy Endpoint URL and Key 1
#
# 3. Fill in the Azure values above
#
# 4. Install dependencies:
#    pip install -r requirements.txt
#
# 5. Initialize database:
#    python init_db.py
#
# 6. Start the server:
#    uvicorn app.main:app --reload
#
# ══════════════════════════════════════════════════════════════
